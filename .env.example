# Domain
APP_URL=https://gogateproducts.store
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://gogate:gogate_secret@localhost:5432/gogate_products

# Redis / queues
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Payment gateways
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_SALT=

# Courier partners
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
NIMBUSPOST_API_KEY=
SHIPDAY_API_KEY=
ZIPPYKIND_API_KEY=
DELIFORCE_API_KEY=
