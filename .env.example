# Maps / routing
GOOGLE_MAPS_API_KEY=

# KYC (Didit)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Storage (product images, documents)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Live chat / support
CHAT_WEBHOOK_URL=
