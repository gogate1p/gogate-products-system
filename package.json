{
  "name": "gogate-products",
  "version": "0.1.0",
  "private": true,
  "description": "Gogate Products — ecommerce marketplace + courier management (gogateproducts.store)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "npm run dev -w @gogate/api",
    "build": "turbo run build",
    "db:generate": "npm run generate -w @gogate/database",
    "db:migrate": "npm run migrate -w @gogate/database",
    "db:push": "npm run push -w @gogate/database",
    "db:studio": "npm run studio -w @gogate/database",
    "db:seed": "npm run seed -w @gogate/database",
    "setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
